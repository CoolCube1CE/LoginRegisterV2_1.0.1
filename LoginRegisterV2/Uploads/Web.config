<?xml version="1.0" encoding="utf-8"?>
<!-- Uploaded beverage photos are served as plain files and can never be run as code. -->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="StaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
