<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LoginRegisterV2.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Beverage Store Management System</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        // Runs immediately, before the page paints, so there's no flash of the wrong theme
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.className = theme === 'dark' ? 'dark-theme' : '';
        })();
    </script>
    <link rel="stylesheet" runat="server" href="~/Content/AppTheme.css?v=4" />
    <link rel="stylesheet" runat="server" href="~/Content/AppLayout.css?v=4" />

    <style>
    .pw-field { position: relative; }
    .pw-field .form-control { padding-right: 48px; }
    .pw-eye { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px;
              display: flex; align-items: center; justify-content: center; background: transparent; border: none;
              border-radius: 8px; color: var(--text-soft); cursor: pointer; padding: 0; }
    .pw-eye .ico { width: 20px; height: 20px; }
    .pw-eye::after { content: ""; position: absolute; width: 22px; height: 2px; background: currentColor;
                     transform: rotate(-45deg); pointer-events: none; }
    .pw-eye.is-visible::after { display: none; }
</style>
</head>

<body>
    <%-- Icon sprite: every icon in the app is drawn from these symbols --%>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="i-bottles" viewBox="0 0 32 32">
                <path d="M13 3h6M14 3v4.5c0 1.6-2.2 2.6-2.2 5V27a1.6 1.6 0 0 0 1.6 1.6h5.2a1.6 1.6 0 0 0 1.6-1.6V12.5c0-2.4-2.2-3.4-2.2-5V3"/>
                <path d="M11.6 17h8.8M11.6 23h8.8"/>
                <path d="M4.5 12h4M5.5 12v3c0 1-1.7 1.7-1.7 3.3V27a1.4 1.4 0 0 0 1.4 1.4h2.6A1.4 1.4 0 0 0 9.2 27v-8.7c0-1.6-1.7-2.3-1.7-3.3v-3"/>
                <path d="M23.5 12h4M24.5 12v3c0 1-1.7 1.7-1.7 3.3V27a1.4 1.4 0 0 0 1.4 1.4h2.6a1.4 1.4 0 0 0 1.4-1.4v-8.7c0-1.6-1.7-2.3-1.7-3.3v-3"/>
            </symbol>
            <symbol id="i-home" viewBox="0 0 24 24"><path d="M12 3 2.5 11.2h2.7V20h5.1v-5.6h3.4V20h5.1v-8.8h2.7z" fill="currentColor" stroke="currentColor" stroke-width="1.2"/></symbol>
            <symbol id="i-box" viewBox="0 0 24 24"><path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></symbol>
            <symbol id="i-box-solid" viewBox="0 0 24 24"><path d="M12 2.8 3.4 7.4v9.2L12 21.2l8.6-4.6V7.4z" fill="currentColor" stroke="currentColor" stroke-width="1.4"/><path d="M3.8 7.6 12 12l8.2-4.4M12 12v8.8" stroke="#fff" stroke-width="1.4" fill="none"/></symbol>
            <symbol id="i-swap" viewBox="0 0 24 24"><path d="M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4"/></symbol>
            <symbol id="i-clipboard" viewBox="0 0 24 24"><rect x="5" y="4.5" width="14" height="16.5" rx="2"/><rect x="9" y="2.5" width="6" height="3.5" rx="1"/><path d="M9 12h6M9 16h4"/></symbol>
            <symbol id="i-sheet" viewBox="0 0 24 24"><rect x="3.5" y="4" width="17" height="16" rx="2.5"/><path d="M3.5 9.4h17M3.5 14.7h17M9.4 9.4V20M14.6 9.4V20"/></symbol>
            <symbol id="i-warn" viewBox="0 0 24 24"><path d="M12 3.4 22 20.6H2z" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 9.6v5M12 17.6v.01" stroke="#fff" stroke-width="2.1" stroke-linecap="round" fill="none"/></symbol>
            <symbol id="i-peso" viewBox="0 0 24 24"><path d="M8 20.5V4h5.2a4.4 4.4 0 0 1 0 8.8H8M5.5 8.4h10.8M5.5 11.4h10.8"/></symbol>
            <symbol id="i-doc" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/></symbol>
            <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
            <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4.2"/><path d="M3.8 21c.8-4.4 4.2-6.2 8.2-6.2s7.4 1.8 8.2 6.2z"/></symbol>
            <symbol id="i-user-plus" viewBox="0 0 24 24"><circle cx="10" cy="8" r="4"/><path d="M2.8 20.5c.8-3.9 3.8-5.5 7.2-5.5M18 14v6M15 17h6"/></symbol>
            <symbol id="i-cal" viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="15" rx="2.5"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/></symbol>
            <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></symbol>
            <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"/></symbol>
            <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="3.5"/><path d="M10.5 12.5 20 3M16 7l3 3"/></symbol>
            <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5.5A1.5 1.5 0 0 0 4 5.5v13A1.5 1.5 0 0 0 5.5 20H10M15 8l4 4-4 4M19 12H9"/></symbol>
            <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5M12 14.5v2.5"/></symbol>
            <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2.5"/><path d="m4 7.5 8 6 8-6"/></symbol>
            <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.6c0 4.4 3.1 8 7.5 9.4 4.4-1.4 7.5-5 7.5-9.4V6z"/><path d="m8.8 12 2.4 2.4 4.2-4.6"/></symbol>
            <symbol id="i-cart" viewBox="0 0 24 24"><path d="M3 4h2.2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8.4a1.5 1.5 0 0 0 1.5-1.1L20.5 8H6.1"/><circle cx="9.5" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></symbol>
            <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></symbol>
            <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4L19 9a2.1 2.1 0 0 0-3-3L5 17z"/><path d="m14.5 7.5 3 3"/></symbol>
            <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l.8 12.5h9.4L17.5 7M10 11v5M14 11v5"/></symbol>
            <symbol id="i-minus" viewBox="0 0 24 24"><path d="M5 12h14"/></symbol>
            <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/></symbol>
            <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3.5 9 4.5-9 4.5L3 8z"/><path d="m3 12.5 9 4.5 9-4.5M3 17l9 4.5 9-4.5"/></symbol>
            <symbol id="i-print" viewBox="0 0 24 24"><path d="M7 9V4h10v5M7 17H5a1.5 1.5 0 0 1-1.5-1.5v-5A1.5 1.5 0 0 1 5 9h14a1.5 1.5 0 0 1 1.5 1.5v5A1.5 1.5 0 0 1 19 17h-2"/><rect x="7" y="14" width="10" height="6.5" rx="1"/></symbol>
            <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></symbol>
            <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20V4M4 20h16M8 16v-4M12.5 16V8M17 16v-6"/></symbol>
        </defs>
    </svg>

<form id="form1" runat="server" enctype="multipart/form-data">
        <div class="app-layout">
            <aside class="app-sidebar">
                <div class="app-sidebar__brand">
                    <span class="brand-icon" aria-hidden="true"><svg class="ico"><use href="#i-bottles" /></svg></span>
                    <span class="brand-text">
                        <strong>Beverage Store</strong>
                        <span class="brand-sub">Management System</span>
                    </span>
                </div>

                <asp:Panel ID="navBar" runat="server" CssClass="app-nav" Visible="false">
                    <asp:HyperLink ID="lnkNavDashboard" runat="server" NavigateUrl="~/Dashboard.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-home" /></svg></span><span class="app-nav__text">Dashboard</span>
                    </asp:HyperLink>
                    <asp:HyperLink ID="lnkNavInventory" runat="server" NavigateUrl="~/Inventory.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-box" /></svg></span><span class="app-nav__text">Inventory</span>
                    </asp:HyperLink>
                    <asp:HyperLink ID="lnkNavStockTransactions" runat="server" NavigateUrl="~/StockTransactions.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-swap" /></svg></span><span class="app-nav__text">Stock Transactions</span>
                    </asp:HyperLink>
                    <asp:HyperLink ID="lnkNavNewOrder" runat="server" NavigateUrl="~/NewOrder.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-cart" /></svg></span><span class="app-nav__text">New Order</span>
                    </asp:HyperLink>
                    <asp:HyperLink ID="lnkNavOrders" runat="server" NavigateUrl="~/Orders.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-clipboard" /></svg></span><span class="app-nav__text">Orders</span>
                    </asp:HyperLink>
                    <asp:HyperLink ID="lnkNavSales" runat="server" NavigateUrl="~/SalesReport.aspx" CssClass="app-nav__link">
                        <span class="app-nav__icon" aria-hidden="true"><svg class="ico"><use href="#i-chart" /></svg></span><span class="app-nav__text">Sales Reports</span>
                    </asp:HyperLink>
                </asp:Panel>

                <asp:Panel ID="profileBar" runat="server" CssClass="profile-menu" Visible="false">
                    <button type="button" class="profile-menu__trigger" id="profileTrigger" onclick="toggleProfileMenu()" aria-haspopup="true" aria-expanded="false">
                        <span class="profile-menu__avatar" aria-hidden="true"><svg class="ico"><use href="#i-user" /></svg></span>
                        <span class="profile-menu__label">
                            <asp:Label ID="lblProfileName" runat="server" CssClass="profile-menu__email" />
                            <asp:Label ID="lblProfileRole" runat="server" CssClass="profile-menu__role" />
                        </span>
                        <span class="profile-menu__caret" aria-hidden="true">&#9662;</span>
                    </button>
                    <div class="profile-menu__dropdown" id="profileDropdown">
                        <a class="profile-menu__item" href="<%= ResolveUrl("~/Profile.aspx") %>"><svg class="ico"><use href="#i-user" /></svg>My Profile</a>
   
                        <% if (IsAdminUser) { %>
                <a class="profile-menu__item" href="<%= ResolveUrl("~/AddAccount.aspx") %>"><svg class="ico"><use href="#i-user-plus" /></svg>Add Account</a>
<% } %>
                        <asp:LinkButton ID="lnkChangePassword" runat="server" CssClass="profile-menu__item" OnClick="lnkChangePassword_Click"><svg class="ico"><use href="#i-key" /></svg>Change Password</asp:LinkButton>
                        <asp:LinkButton ID="lnkLogout" runat="server" CssClass="profile-menu__item profile-menu__item--danger" CausesValidation="false" OnClick="lnkLogout_Click"><svg class="ico"><use href="#i-logout" /></svg>Log Out</asp:LinkButton>
                    </div>
                </asp:Panel>
            </aside>

            <div class="app-content">
                <header class="app-topbar">
                    <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Switch between light and dark theme" title="Switch theme">
                        <span class="theme-toggle__opt theme-toggle__opt--light" aria-hidden="true"><svg class="ico"><use href="#i-sun" /></svg></span>
                        <span class="theme-toggle__opt theme-toggle__opt--dark" aria-hidden="true"><svg class="ico"><use href="#i-moon" /></svg></span>
                    </button>

                    <div class="topbar-menu">
                        <button type="button" class="topbar-avatar" id="topbarTrigger" onclick="toggleTopbarMenu()" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
                            <svg class="ico"><use href="#i-user" /></svg>
                        </button>
                        <div class="topbar-menu__dropdown" id="topbarDropdown">
                            <a class="topbar-menu__item" href="<%= ResolveUrl("~/Profile.aspx") %>"><svg class="ico"><use href="#i-user" /></svg>My Profile</a>
                           <% if (IsAdminUser) { %>
                           <a class="topbar-menu__item" href="<%= ResolveUrl("~/AddAccount.aspx") %>"><svg class="ico"><use href="#i-user-plus" /></svg>Add Account</a>
<% } %>
                            <a class="topbar-menu__item" href="<%= ResolveUrl("~/ChangePasswordOTP.aspx") %>"><svg class="ico"><use href="#i-key" /></svg>Change Password</a>
                            <button type="button" class="topbar-menu__item topbar-menu__item--danger" onclick="__doPostBack('<%= lnkLogout.UniqueID %>', '')"><svg class="ico"><use href="#i-logout" /></svg>Log Out</button>
                        </div>
                    </div>
                </header>

                <main class="app-main">
                    <asp:Panel ID="pnlLowStock" runat="server" CssClass="low-stock-banner" Visible="false">
                        <svg class="ico" aria-hidden="true"><use href="#i-warn" /></svg>
                        <asp:Label ID="lblLowStock" runat="server" />
                        <asp:HyperLink ID="lnkLowStock" runat="server" NavigateUrl="~/Inventory.aspx?filter=low" CssClass="low-stock-banner__link">View items &rarr;</asp:HyperLink>
                    </asp:Panel>
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <footer class="app-footer">
                    Beverage Store Management System
                </footer>
            </div>
        </div>
    </form>

    <script>
        function toggleTheme() {
            var isDark = document.documentElement.className === 'dark-theme';
            var newTheme = isDark ? 'light' : 'dark';
            document.documentElement.className = newTheme === 'dark' ? 'dark-theme' : '';
            localStorage.setItem('theme', newTheme);
        }

        function closeMenu(dropdownId, triggerId) {
            var dropdown = document.getElementById(dropdownId);
            var trigger = document.getElementById(triggerId);
            if (dropdown) dropdown.classList.remove('is-open');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }

        function toggleMenu(dropdownId, triggerId, otherDropdownId, otherTriggerId) {
            var dropdown = document.getElementById(dropdownId);
            var trigger = document.getElementById(triggerId);
            if (!dropdown) return;
            closeMenu(otherDropdownId, otherTriggerId);
            var isOpen = dropdown.classList.toggle('is-open');
            if (trigger) trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        }

        function toggleProfileMenu() { toggleMenu('profileDropdown', 'profileTrigger', 'topbarDropdown', 'topbarTrigger'); }
        function toggleTopbarMenu() { toggleMenu('topbarDropdown', 'topbarTrigger', 'profileDropdown', 'profileTrigger'); }

        document.addEventListener('click', function (evt) {
            [['profileDropdown', 'profileTrigger'], ['topbarDropdown', 'topbarTrigger']].forEach(function (ids) {
                var dropdown = document.getElementById(ids[0]);
                var trigger = document.getElementById(ids[1]);
                if (!dropdown || !dropdown.classList.contains('is-open')) return;
                if (dropdown.contains(evt.target) || (trigger && trigger.contains(evt.target))) return;
                closeMenu(ids[0], ids[1]);
            });
        });

        // After a postback the page keeps its scroll position (Web.config), so if a success/error
        // message appeared above the visible area, bring it into view instead of hiding it.
        window.addEventListener('load', function () {
            setTimeout(function () {
                var alerts = document.querySelectorAll('.app-main .alert');
                for (var i = 0; i < alerts.length; i++) {
                    var a = alerts[i];
                    if (!a.textContent.trim() || a.offsetParent === null) continue;
                    var r = a.getBoundingClientRect();
                    if (r.top < 70 || r.bottom > window.innerHeight) {
                        a.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                    break;
                }
            }, 120);
        });

        document.addEventListener('keydown', function (evt) {
            if (evt.key === 'Escape') {
                closeMenu('profileDropdown', 'profileTrigger');
                closeMenu('topbarDropdown', 'topbarTrigger');
            }
        });
    </script>

    <script>
    // Eye icon for every password box that doesn't already have one (Forgot, Change, Add Account...)
    (function () {
        var inputs = document.querySelectorAll('input[type=password]');
        for (var i = 0; i < inputs.length; i++) {
            var inp = inputs[i];
            if (inp.closest('.pw-field') || inp.closest('.input-icon')) { continue; }
            var wrap = document.createElement('div');
            wrap.className = 'pw-field';
            inp.parentNode.insertBefore(wrap, inp);
            wrap.appendChild(inp);
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'pw-eye';
            btn.setAttribute('aria-label', 'Show password');
            btn.innerHTML = '<svg class="ico"><use href="#i-eye"></use></svg>';
            btn.addEventListener('click', (function (input, button) {
                return function () {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.classList.toggle('is-visible', show);
                    button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                };
            })(inp, btn));
            wrap.appendChild(btn);
        }
    })();

    <% if (IsLoggedInUser) { %>
    // Auto-logout: warning at 45 seconds, logout at 1 minute without activity
    (function () {
        var WARN_MS = 45 * 1000, IDLE_MS = 60 * 1000;
        var warnTimer, outTimer;

        var banner = document.createElement('div');
        banner.setAttribute('role', 'alert');
        banner.style.cssText = 'display:none;position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:9999;' +
            'background:#b45309;color:#fff;padding:12px 20px;border-radius:10px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,.25)';
        banner.textContent = 'Your session will expire soon due to inactivity.';
        document.body.appendChild(banner);

        function logout() {
            window.location.href = '<%= ResolveUrl("~/Login.aspx?timeout=1") %>';
        }
        function reset() {
            clearTimeout(warnTimer);
            clearTimeout(outTimer);
            banner.style.display = 'none';
            warnTimer = setTimeout(function () { banner.style.display = 'block'; }, WARN_MS);
            outTimer = setTimeout(logout, IDLE_MS);
        }

        ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(function (ev) {
            document.addEventListener(ev, reset, { passive: true });
        });
        reset();
    })();
    <% } %>
</script>

</body>
</html>
